    {
      "parameters": {
        "jsCode": "// Calculate attendance % for every row and flag low attendance\nconst items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  const total = Number(data.Total_Classes) || 0;\n  const attended = Number(data.Attended_Classes) || 0;\n  const pct = total > 0 ? (attended / total) * 100 : 0;\n\n  return {\n    json: {\n      ...data,\n      attendance_pct: Math.round(pct * 100) / 100,\n      isLow: pct < 75\n    }\n  };\n});"
      },
