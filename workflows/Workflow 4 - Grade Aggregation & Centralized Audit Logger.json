    {
      "parameters": {
        "jsCode": "// Format Log Entry: build a clean, sanitized log record\nconst input = $input.item.json;\n\nfunction sanitize(value) {\n  if (typeof value !== 'string') return value;\n  // Strip characters that could trigger formula injection in Google Sheets\n  return value.replace(/^[=+\\-@]/, \"'$&\").substring(0, 500);\n}\n\nconst eventType = sanitize(input.event_type || 'INFO');\nconst userId = sanitize(input.user_id || 'unknown');\nconst details = sanitize(JSON.stringify(input.details || {}));\nconst sourceWorkflow = sanitize(input.source_workflow || 'unspecified');\n\nconst allowedSeverities = ['INFO', 'WARNING', 'CRITICAL_ERROR'];\nconst severity = allowedSeverities.includes((input.severity || '').toUpperCase())\n  ? input.severity.toUpperCase()\n  : 'INFO';\n\nreturn {\n  json: {\n    timestamp: new Date().toISOString(),\n    event_type: eventType,\n    severity: severity,\n    user_id: userId,\n    source_workflow: sourceWorkflow,\n    details: details\n  }\n};"
      },
