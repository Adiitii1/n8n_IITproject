    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates?.[0]?.content?.parts?.[0]?.text || '';\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { grade: 0, feedback: '[PARSE ERROR - check Gemini prompt] AI did not return valid JSON. Raw output: ' + raw.substring(0, 300) };\n}\n\nconst grade = Number(parsed.grade) || 0;\nconst feedback = parsed.feedback || '';\n\nreturn [{\n  json: {\n    grade: grade,\n    feedback: feedback,\n    needs_review: grade < 50\n  }\n}];"
      },
