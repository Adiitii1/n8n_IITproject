      "parameters": {
        "jsCode": "const student = $json;\nconst completionDate = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });\nconst name = student.Name || student.Student_Name || 'Student';\nconst program = student.Program || '';\nconst studentId = student.Student_ID || student['Student ID'] || '';\nconst fileName = `Certificate_${studentId}.pdf`;\n\nconst html = `\n<html>\n<body style=\"font-family: Georgia, serif; text-align:center; padding:60px; border:10px solid #1a1a66;\">\n  <h1 style=\"color:#1a1a66;\">Certificate of Completion</h1>\n  <p style=\"font-size:16px;\">This certifies that</p>\n  <h2>${name}</h2>\n  <p style=\"font-size:14px;\">has successfully completed the <b>${program}</b> program</p>\n  <p style=\"font-size:12px;\">Completion Date: ${completionDate}</p>\n  <p style=\"font-size:10px; color:#666;\">Student ID: ${studentId}</p>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    ...student,\n    certificate_html: html,\n    certificate_filename: fileName\n  }\n}];"
      },
